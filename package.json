{
  "name": "@enhanced-dom/webpack",
  "version": "0.5.1",
  "description": "Helpers for webpack configuration",
  "keywords": [],
  "repository": "https://github.com/enhanced-dom/webpack.git",
  "license": "MIT",
  "author": "CD9B4A105290E17E0948E021DF4105107C88693C59C0B891CCC08366C51AEA990902A6A156AC87D88A2FC41422A5E1C3C4071F251F19441C4516000EC25F87DF",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "configure-claude": "@enhanced-dom-claude --configs react code agent rtk devcontainer caveman-lite",
    "configure-lint": "@enhanced-dom-fallow --gitignore && @enhanced-dom-npmrc --gitignore && @enhanced-dom-nvmrc --gitignore && @enhanced-dom-husky --gitignore",
    "configure-build": "@enhanced-dom-bootstrap-tsconfig",
    "prepare": "npm run configure-lint && npm run configure-claude && npm run configure-build",
    "prebuild": "rimraf dist/*",
    "build": "tsc -p ./tsconfig.json",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "postbuild": "tsc-esm-fix --target=dist && node --import tsx scripts/generate-notice-cli.ts --folder dist && copyfiles LICENSE.md README.md dist && copyfiles -u 1 \"src/**/*.cjs\" \"src/**/*.d.cts\" dist && @enhanced-dom-copy-packagejson",
    "package": "cd dist && npm pack",
    "lint": "eslint --fix --config eslint.config.mjs src test",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config test/jest.config.mjs"
  },
  "dependencies": {
    "@enhanced-dom/build": "^0.3.2",
    "@mdx-js/loader": "^3.1.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cssnano-preset-advanced": "^9.3.0",
    "html-inline-css-webpack-plugin": "^1.11.2",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "ignore-emit-webpack-plugin": "^2.0.6",
    "markdown-loader": "^8.0.0",
    "memory-fs": "^0.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "null-loader": "^4.0.1",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "enhanced-resolve": "^5.26.0",
    "postcss": "^8.5.29",
    "postcss-discard-comments": "^9.0.7",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-nested": "^8.0.1",
    "postcss-normalize-whitespace": "^9.0.6",
    "postcss-preset-env": "^11.6.1",
    "postcss-scss": "^4.0.9",
    "raw-loader": "^4.0.2",
    "remark-code-import": "^1.2.0",
    "remark-embed-images": "^5.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "resolve-url-loader": "^5.0.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.0",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-license-plugin": "^4.5.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@enhanced-dom/claude": "^0.3.1",
    "@enhanced-dom/jest": "^0.3.0",
    "@enhanced-dom/lint": "^0.4.2",
    "@types/memory-fs": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/optimize-css-assets-webpack-plugin": "^5.0.8",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0"
  },
   "engines": {
    "node": ">=22.23.2",
    "npm": ">=12"
  }
}
